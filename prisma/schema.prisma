datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum CourseStatus {
  PASSED      // 合格
  FAILED      // 不合格
  IN_PROGRESS // 履修中
}

// ==========================================
// 1. ユーザーモデル (基本情報 + API利用状況)
// ==========================================
model User {
  id                String    @id @default(uuid())
  email             String?   @unique
  name              String?
  dailyRequestCount Int       @default(0) @map("daily_request_count")
  lastRequestDate   DateTime? @map("last_request_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // リレーション
  courses           UserCourse[]

  @@map("users")
}

// ==========================================
// 2. シラバス科目データ (検索・ベクトル化対象)
// ==========================================
model SyllabusDocument {
  id             String   @id @default(uuid())
  courseId       String   @map("course_id")       // 科目ID (例: "10010401/23002")
  academicYear   String   @map("academic_year")   // 開講年度 (例: "2026")
  curriculumYear String   @map("curriculum_year") // カリキュラム年度 / 入学年度 (例: "2026")
  department     String                           // 学科名 (例: "システム情報学科")
  categoryType   String   @map("category_type")   // 履修区分 (例: "教養必修", "専門選択")

  // 詳細ページ取得項目
  title          String                           // 科目名 (UserCourse.name と照合)
  instructor     String?                          // 担当教員・研究室
  yearLevel      String?  @map("year_level")      // 配当年次
  semester       String?                          // 学期
  credits        String?                          // 単位数
  courseType     String?  @map("course_type")     // 授業形態

  summary        String?  @db.Text                // 授業概要
  goals          String?  @db.Text                // 授業における学修の到達目標
  evaluation     String?  @db.Text                // 成績評価の方法およびその基準
  hasTextbook    Boolean  @default(false) @map("has_textbook") // 教科書有無
  prerequisites  String?  @map("prerequisites") @db.Text       // 単位習得が望ましい科目

  combinedText   String   @map("combined_text") @db.Text // ベクトル検索・生成用の統合テキスト
  url            String                           // シラバス詳細ページURL

  // pgvector (Gemini models/gemini-embedding-001 用 768次元)
  embedding      Unsupported("vector(768)")?

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // 同じ科目が異なる年度・学科・カリキュラムで開設される場合に対応した複合一意制約
  @@unique([courseId, academicYear, department, curriculumYear], name: "syllabus_unique")
  @@index([academicYear])
  @@index([curriculumYear])
  @@index([department])
  @@index([title])
  @@map("syllabus_documents")
}

// ==========================================
// 3. 履修済み・履修中科目 (RAG除外フィルター用)
// ==========================================
model UserCourse {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String                                // 科目名 (SyllabusDocument.title と照合)
  credits   Float                                 // 単位数
  status    CourseStatus                          // PASSED | FAILED | IN_PROGRESS
  grade     String                                // "秀" | "優" | "良" | "可" | "不可" | "履修"
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId])
  @@map("user_courses")
}